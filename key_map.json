    "GROUPPCOUTPUTGAIN": "group_pc_output_gain",
    "GROUPPCOUTPUTMUTE": "group_pc_output_mute",
    "GROUPPCRECORDMUTE": "group_pc_record_mute",
    "GROUPPROGGAIN": "group_prog_gain",
    "GROUPPROGMUTE": "group_prog_mute",
    "GROUPROOMMUTE": "group_room_mute",
    "GROUPVOICELIFTMUTE": "group_voice_lift_mute",
