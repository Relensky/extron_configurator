    "INPUT": "input",
    "IPADDRESS": "ip_address",
    "KEEPALIVECOMMAND": "keep_alive_command",
    "KEEPALIVEINTERVAL": "keep_alive_interval",
    "KEEPALIVEQUALIFIER": "keep_alive_qualifier",
    "KEEPALIVETRIGGER": "keep_alive_trigger",
    "LBLNAME": "lbl_name",
    "MANUALDISCONNECT": "manual_disconnect",
    "MODEL": "model",
    "MODULE": "module",
    "NAME": "name",
    "NETPORT": "net_port",
    "PASSWORD": "password",
    "PROTOCOL": "protocol",
    "RELAYHOST": "relay_host",
    "RELAYPORTDOWN": "relay_port_down",
    "RELAYPORTSTOP": "relay_port_stop",
    "RELAYPORTUP": "relay_port_up",
    "SERIALPORT": "serial_port",
    "SERVICEPORT": "service_port",
    "USEDEVICEMUTE": "use_device_mute",
    "USER": "user"
  },
  "value_map": {
    "__comment": "Add entries here to normalize legacy values, e.g. \"com_type\": {\"NETWORK\": \"Network\", \"SERIAL\": \"Serial\"}",
    "com_type": {
      "NETWORK": "Network",
      "SERIAL": "Serial",
      "SERIALOVERETHERNET": "SerialOverEthernet"
    },
    "protocol": {
      "TCP/IP": "TCP",
      "tcp": "TCP",
      "udp": "UDP",
      "ssh": "SSH"
    }
  },
  "__defaults_note": "Injected ONLY when the key is missing after mapping \u2014 existing values are never overwritten. '{n}' becomes the device number from the section name.",
