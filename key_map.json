{
  "map_version": 1,
  "__readme": [
    "Legacy config.json key mapping. Applied automatically every time a config",
    "is loaded (local open or SFTP download), BEFORE template migration. Every",
    "rename and injected default appears in the migration dialog and audit log.",
    "Edit this file and reload \u2014 no application rebuild needed.",
    "",
    "sections:   top-level section renames. 'match' is a regex that must match",
    "            the whole section name; $1..$9 insert capture groups.",
    "properties: flat OLDNAME -> new_name map applied inside every section.",
    "value_map:  optional per-property value normalization, e.g.",
    "            { \"com_type\": { \"NETWORK\": \"Network\" } }.",
    "defaults:   per section family (wildcard *), keys injected when missing.",
    "Keys starting with '__' anywhere are ignored (use them for comments)."
  ],
  "sections": [
    {
      "match": "CAMERA(\\d+)DEVICE",
      "rename_to": "CAMERADEVICE_$1"
    },
    {
      "match": "CAMERADEVICE(\\d+)",
      "rename_to": "CAMERADEVICE_$1"
    },
    {
      "match": "CAMERADEVICE",
      "rename_to": "CAMERADEVICE_1"
    },
    {
      "match": "PROJECTOR(\\d+)DEVICE",
      "rename_to": "PROJECTORDEVICE_$1"
    },
    {
      "match": "PROJECTORDEVICE(\\d+)",
      "rename_to": "PROJECTORDEVICE_$1"
    },
    {
      "match": "PROJECTORDEVICE",
      "rename_to": "PROJECTORDEVICE_1"
    },
    {
      "match": "SWITCHER(\\d+)DEVICE",
      "rename_to": "SWITCHERDEVICE_$1"
    },
    {
      "match": "SWITCHERDEVICE(\\d+)",
      "rename_to": "SWITCHERDEVICE_$1"
    },
    {
      "match": "SWITCHERDEVICE",
      "rename_to": "SWITCHERDEVICE_1"
    },
    {
      "match": "DSP(\\d+)DEVICE",
      "rename_to": "DSPDEVICE_$1"
    },
    {
      "match": "DSPDEVICE(\\d+)",
      "rename_to": "DSPDEVICE_$1"
    },
    {
      "match": "DSPDEVICE",
      "rename_to": "DSPDEVICE_1"
    },
    {
      "match": "USB(\\d+)DEVICE",
      "rename_to": "USBDEVICE_$1"
    },
    {
      "match": "USBDEVICE(\\d+)",
      "rename_to": "USBDEVICE_$1"
    },
    {
      "match": "USBDEVICE",
      "rename_to": "USBDEVICE_1"
    },
    {
      "match": "POWER(\\d+)DEVICE",
      "rename_to": "POWERDEVICE_$1"
    },
    {
      "match": "POWERDEVICE(\\d+)",
      "rename_to": "POWERDEVICE_$1"
    },
    {
      "match": "POWERDEVICE",
      "rename_to": "POWERDEVICE_1"
    },
    {
      "match": "MEDIAPORT(\\d+)DEVICE",
      "rename_to": "MEDIAPORTDEVICE_$1"
    },
    {
      "match": "MEDIAPORTDEVICE(\\d+)",
      "rename_to": "MEDIAPORTDEVICE_$1"
    },
    {
      "match": "MEDIAPORTDEVICE",
      "rename_to": "MEDIAPORTDEVICE_1"
    },
    {
      "match": "WIRELESS(\\d+)DEVICE",
      "rename_to": "WIRELESSDEVICE_$1"
    },
    {
      "match": "WIRELESSDEVICE(\\d+)",
      "rename_to": "WIRELESSDEVICE_$1"
    },
    {
      "match": "WIRELESSDEVICE",
      "rename_to": "WIRELESSDEVICE_1"
    },
    {
      "match": "RECORDER(\\d+)DEVICE",
      "rename_to": "RECORDERDEVICE_$1"
    },
    {
      "match": "RECORDERDEVICE(\\d+)",
      "rename_to": "RECORDERDEVICE_$1"
    },
    {
      "match": "RECORDERDEVICE",
      "rename_to": "RECORDERDEVICE_1"
    },
    {
      "match": "SCREEN(\\d+)DEVICE",
      "rename_to": "SCREENDEVICE_$1"
    },
    {
      "match": "SCREENDEVICE(\\d+)",
      "rename_to": "SCREENDEVICE_$1"
    },
    {
      "match": "SCREENDEVICE",
      "rename_to": "SCREENDEVICE_1"
    },
    {
      "match": "SYSTEMSETUP|SYSTEM SETUP",
      "rename_to": "SYSTEM_SETUP"
    }
  ],
  "properties": {
    "__comment": "Legacy property name -> current name. Auto-derived rule: legacy = UPPERCASE with underscores removed (COMTYPE -> com_type). Add/edit entries for any legacy spellings that differ.",
    "AUTORECONNECT": "auto_reconnect",
    "BTNNAME": "btn_name",
    "COMTYPE": "com_type",
    "DEVICEID": "device_id",
    "GROUPCEILMUTE": "group_ceil_mute",
    "GROUPMICCEILINGMUTE": "group_mic_ceiling_mute",
    "GROUPMICGAIN": "group_mic_gain",
    "GROUPMICINROOMMUTE": "group_mic_in_room_mute",
    "GROUPMICMASTERGAIN": "group_mic_master_gain",
    "GROUPMICMASTERMUTE": "group_mic_master_mute",
    "GROUPMICMUTE": "group_mic_mute",
